{
  "name": "super-triki-monorepo",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w server\"",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "engine.io": "^6.6.11",
    "engine.io-client": "^6.6.7",
    "socket.io-adapter": "^2.5.8",
    "socket.io-parser": "^4.2.7",
    "ws": "^8.21.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.11"
  }
}
